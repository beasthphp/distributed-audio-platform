# Python environments and caches
.venv/
**/.venv/
__pycache__/
*.py[cod]

# CMake and C++ generated output
stream-server/build/
**/build/
*.exe
*.obj
*.pdb
*.ilk

# Local test audio
upload-api/sample.mp3
downloaded.mp3
full-download.mp3

# Generated ready audio
upload-api/storage/ready/*
