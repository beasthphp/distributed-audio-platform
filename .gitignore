# Generated job metadata
upload-api/storage/metadata/*
!upload-api/storage/metadata/.gitkeep

# Uploaded source audio
upload-api/storage/uploads/*
!upload-api/storage/uploads/.gitkeep

# Temporary transfer/processing artifacts
*.part
*.bin
*-headers.txt

# Editor / OS noise
.DS_Store
Thumbs.db
